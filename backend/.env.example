PORT=777
NODE_ENV=development

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Required when initializing an empty database or running the SQLite migration.
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=erp_meeting_tracker

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Optional absolute path when mysqldump is not available on PATH.
MYSQLDUMP_PATH=

# ManageEngine ServiceDesk Plus Cloud (optional). Obtain an offline refresh token with
# SDPOnDemand.requests.READ. Keep all real values only in backend/.env.
MANAGEENGINE_SYNC_ENABLED=false
MANAGEENGINE_SYNC_INTERVAL_MINUTES=30
MANAGEENGINE_SYNC_RUN_ON_START=true
MANAGEENGINE_ACCOUNTS_URL=https://accounts.zoho.com
MANAGEENGINE_API_DOMAIN=
MANAGEENGINE_PORTAL=
MANAGEENGINE_CLIENT_ID=
MANAGEENGINE_CLIENT_SECRET=
# Temporary and single-use. `npm run manageengine:exchange-code` removes it after saving the
# resulting refresh token into backend/.env.
MANAGEENGINE_AUTH_CODE=
MANAGEENGINE_REFRESH_TOKEN=
MANAGEENGINE_EXTERNAL_TECHNICIAN=Deloitte ERP Support
MANAGEENGINE_TIME_ZONE=Asia/Kolkata
MANAGEENGINE_SYNC_MAX_PAGES=100
